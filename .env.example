# DJI Drone Fleet & Flight Analytics Platform Environment Configuration

# Core App
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Authentication & Security
JWT_SECRET=dji-fleet-super-secure-production-secret-token-32chars
JWT_EXPIRATION=7d
COOKIE_SECRET=dji-fleet-cookie-secret-key-salt-987654321

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/dji_fleet?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=dji_fleet

# Redis (Queues & Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=dji-raw-flight-logs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Parser Microservice
PARSER_SERVICE_URL=http://parser:8000
PARSER_SERVICE_TIMEOUT_MS=60000

# Optional DJI API Key for Decrypting v13/v14 Flight Records
DJI_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
